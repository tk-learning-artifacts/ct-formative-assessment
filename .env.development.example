# Settings for `npm run dev`. Copy this file to .env.development (gitignored)
# and edit it. `npm run dev` refuses to start while .env.development is missing.
# Production settings live in .env, which only docker compose reads.

# Optional. Defaults to 3000; the Vite proxy expects 3000.
PORT=3000

# Keep the dev backend off the local network.
HOST=127.0.0.1

# Optional. The dev database seeds teacher@ctquest.local / changeme123 when
# these are blank. They only apply to an empty database.
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=

# AI scoring stays off in development so testing costs nothing. To try it,
# set AI_PROVIDER=openrouter and AI_API_KEY; each AI-scored answer is a paid
# OpenRouter call (about US$0.003).
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

SUBMIT_GRACE_SECONDS=60
TZ=Asia/Singapore
