# Copy this file to .env and fill in values before running

# Required in production. Any long random string.
JWT_SECRET=change-me-in-production

# Required in production: the first teacher account, created only when the
# database has no users. Must not be the demo password "changeme123".
SEED_TEACHER_EMAIL=teacher@example.edu.sg
SEED_TEACHER_PASSWORD=

# Optional. Create the events listed in backend/content/seeded-events.json on
# start (the RGSynapse challenge). Set to false to leave them out.
SEED_EVENTS=true

# Optional. Defaults to 3000.
PORT=3000

# Optional. Seconds after an attempt's deadline that a submission still
# counts as on time (later ones are stored and flagged late). Defaults to 60.
SUBMIT_GRACE_SECONDS=60

# Optional. AI scoring of open-response questions is off unless a provider
# is set. To enable: AI_PROVIDER=openrouter and your OpenRouter key. AI_MODEL
# defaults to anthropic/claude-sonnet-5. See "AI scoring" in the README.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_CONCURRENCY=
AI_TIMEOUT_SECONDS=
AI_APP_URL=

# Optional. Only affects log timestamps; stored times are UTC.
TZ=Asia/Singapore
